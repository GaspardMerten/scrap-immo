# Google Gemini API Key (default AI provider for scraper generation)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (alternative to Gemini, for GPT-4 based scraper generation)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (alternative to Gemini, for Claude based scraper generation)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database URL (defaults to SQLite if not set)
# SQLite (default):
DATABASE_URL=sqlite:///./scrap_immo.db

# PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/scrap_immo

# MySQL example:
# DATABASE_URL=mysql://username:password@localhost:3306/scrap_immo
